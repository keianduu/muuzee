# Browser-visible, environment-specific Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Use independent values for every environment and purpose.
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_LIFECYCLE_MARKER_SECRET=
PASSWORD_RECOVERY_MARKER_SECRET=

# Optional server-side Japan Post postal lookup. The URL template must contain
# {postalCode}. Provision according to the authenticated Japan Post API reference.
JAPAN_POST_POSTAL_API_URL_TEMPLATE=
JAPAN_POST_POSTAL_API_BEARER_TOKEN=

# Optional server-side Japan Search configuration.
JPSEARCH_BASE_URL=https://jpsearch.go.jp
JPSEARCH_DATABASE_ID=exhib
JPSEARCH_REQUEST_DELAY_MS=750

# Optional LOCAL-only Docker tooling override. Never configure in Vercel.
MUUZEE_DB_CONTAINER=supabase_db_muuzee
