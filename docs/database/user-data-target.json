  "derivedData": [
    "Visit count",
    "Exhibition count",
    "Museum count",
    "Artist count",
    "City count",
    "Country count"
  ],
  "excludedFromTargetV1": [
    {
      "name": "user_seen_items",
      "status": "Future / Excluded",
      "reason": "MVP recommendation derives 行った and Exhibition/Venue/Artist history from user_visits. Add a separate action only if Product approves direct Artist/Work Seen semantics."
    },
    {
      "name": "user_favorite_items",
      "status": "Future / Excluded",
      "reason": "Favorite meaning, targets and difference from Saved are not approved."
    },
    {
      "name": "user_preferences",
      "status": "Future / Excluded",
      "reason": "No concrete Production preference fields are approved; do not create an empty generic bucket."
    },
    {
      "name": "user_stats",
      "status": "Future / Excluded",
      "reason": "MVP stats are derived from user_visits and canonical relations; a future cache must be rebuildable."
    }
  ],
  "externalClientState": [
    {
      "name": "Guest Saved Store",
      "status": "Client-owned / Order 240",
      "notes": "Outside the server Target ER. Stores canonical entity kind + UUID only; merge policy is owned by Order 240."
    }
  ],
  "taskMapping": [
    {
      "order": "Order 200",
      "responsibility": "Implement profiles, minimal Auth-user bootstrap/backfill, avatar object-path boundary and update timestamps."
    },
    {
      "order": "Order 210 scope revision or split follow-ups",
      "responsibility": "Implement Account Saved, approved Visit history, and approved ArtWall settings/membership after Human Decisions are resolved."
    },
    {
      "order": "Order 220",
      "responsibility": "Implement typed repositories/API boundaries for Profile, Saved, Visit and ArtWall without exposing raw tables to UI."
    },
    {
      "order": "Order 230",
      "responsibility": "Implement and test owner RLS for every user-owned table using auth.uid() = user_id."
    },
    {
      "order": "Order 240",
      "responsibility": "Define Guest Saved storage, expiry, idempotent Account merge, cleanup and logout behavior; no Guest server table."
    },
    {
      "order": "Order 250",
      "responsibility": "Approve consent retention/delete/export policy before user_legal_consents migration and finalize account-delete behavior."
    }
  ],
  "humanDecisions": [
    {
      "topic": "Seen vs Visit",
      "recommendation": "Use repeatable user_visits as the MVP Source of Truth and derive 行った / Exhibition / Venue / Artist history.",
      "alternative": "Add user_seen_items only if direct Artist/Work Seen is approved as a separate Product action."
    },
    {
      "topic": "Favorite MVP inclusion",
      "recommendation": "Exclude user_favorite_items from Target v1 until meaning, targets and Saved distinction are approved.",
      "alternative": "Include a separate action table after Product approves the contract."
    },
    {
      "topic": "ArtWall persisted settings",
      "recommendation": "Approve only the six explicit Prototype-derived candidates shown in user_artwall_settings, or remove unapproved columns before migration.",
      "alternative": "Delay presentation settings and ship membership/order first; do not use an unconstrained JSON bag."
    },
    {
      "topic": "Visit memo / rating / photos",
      "recommendation": "Exclude them from MVP Target v1 and keep user_visits as the minimal event record.",
      "alternative": "Add dedicated private child records in a later Visit Log task after privacy/rights requirements are approved."
    },
    {
      "topic": "Preferences MVP scope",
      "recommendation": "Exclude user_preferences until concrete fields and ownership are approved.",
      "alternative": "Add explicit typed columns in a later task; never create an empty generic settings table."
    }
  ]
}
